[Unit]
Description=Auto-Remediation Webhook Service
After=network.target

[Service]
Type=simple
User=root
# PIDFile must match what webhook.py writes
PIDFile=/run/auto-remediation-webhook.pid
EnvironmentFile=-/etc/default/auto-remediation-webhook
Environment=AUTO_REMEDIATE=true
Environment=WEBHOOK_PORT=5001
Environment=REMEDIATION_DIR=/opt/monitoring/remediate
Environment=SLACK_WEBHOOK_URL=
ExecStart=/usr/bin/python3 /opt/monitoring/webhook.py
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
