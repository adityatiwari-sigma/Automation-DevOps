{{ define "email.alert" }}
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 20px; background: #f5f6fa; }
    .container { max-width: 640px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .header-p1 { background: linear-gradient(135deg, #e74c3c, #c0392b); color: #fff; padding: 20px 24px; }
    .header-p2 { background: linear-gradient(135deg, #f39c12, #e67e22); color: #fff; padding: 20px 24px; }
    .header-p3 { background: linear-gradient(135deg, #3498db, #2980b9); color: #fff; padding: 20px 24px; }
    .header-resolved { background: linear-gradient(135deg, #27ae60, #2ecc71); color: #fff; padding: 20px 24px; }
    .header h1 { margin: 0; font-size: 20px; font-weight: 600; }
    .header p { margin: 4px 0 0; font-size: 13px; opacity: 0.9; }
    .body { padding: 24px; }
    .alert-card { background: #f8f9fa; border-left: 4px solid #e74c3c; border-radius: 4px; padding: 16px; margin-bottom: 16px; }
    .alert-card.p2 { border-left-color: #f39c12; }
    .alert-card.p3 { border-left-color: #3498db; }
    .alert-card.resolved { border-left-color: #27ae60; }
    .label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: #7f8c8d; letter-spacing: 0.5px; margin-bottom: 4px; }
    .value { font-size: 14px; color: #2c3e50; margin-bottom: 12px; word-break: break-word; }
    .meta-grid { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
    .meta-item { flex: 1; min-width: 120px; background: #fff; border: 1px solid #ecf0f1; border-radius: 4px; padding: 8px 12px; }
    .btn { display: inline-block; background: #3498db; color: #fff !important; text-decoration: none; padding: 10px 20px; border-radius: 4px; font-size: 13px; font-weight: 600; margin-top: 8px; }
    .btn:hover { background: #2980b9; }
    .footer { padding: 16px 24px; background: #f8f9fa; border-top: 1px solid #ecf0f1; font-size: 12px; color: #95a5a6; text-align: center; }
    .footer a { color: #3498db; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    {{ if eq .Status "resolved" }}
    <div class="header-resolved header">
      <h1>✅ RESOLVED</h1>
      <p>Alert group: {{ .GroupLabels.alertname }} | Severity: {{ .GroupLabels.severity | toUpper }}</p>
    </div>
    {{ else }}
      {{ if eq (index .GroupLabels "severity") "p1" }}
      <div class="header-p1 header">
        <h1>🚨 P1 — CRITICAL / IMMEDIATE</h1>
        <p>Respond NOW — this alert requires immediate attention</p>
      </div>
      {{ else if eq (index .GroupLabels "severity") "p2" }}
      <div class="header-p2 header">
        <h1>⚠️ P2 — HIGH / WITHIN 1 HOUR</h1>
        <p>Respond within 1 hour — service degradation detected</p>
      </div>
      {{ else }}
      <div class="header-p3 header">
        <h1>ℹ️ P3 — LOW / DAILY DIGEST</h1>
        <p>Review during business hours — no immediate action needed</p>
      </div>
      {{ end }}
    {{ end }}

    <!-- Alert Details -->
    <div class="body">
      {{ range .Alerts }}
      <div class="alert-card {{ if eq .Status "resolved" }}resolved{{ else }}{{ .Labels.severity }}{{ end }}">

        <div class="label">Alert</div>
        <div class="value"><strong>{{ .Labels.alertname }}</strong></div>

        <div class="label">Summary</div>
        <div class="value">{{ .Annotations.summary }}</div>

        {{ if .Annotations.description }}
        <div class="label">Description</div>
        <div class="value">{{ .Annotations.description }}</div>
        {{ end }}

        <div class="meta-grid">
          {{ if .Annotations.platform }}
          <div class="meta-item">
            <div class="label">Platform</div>
            <div class="value">{{ .Annotations.platform }}</div>
          </div>
          {{ end }}
          {{ if .Annotations.environment }}
          <div class="meta-item">
            <div class="label">Environment</div>
            <div class="value">{{ .Annotations.environment }}</div>
          </div>
          {{ end }}
          <div class="meta-item">
            <div class="label">Service</div>
            <div class="value">{{ .Labels.service }}</div>
          </div>
          <div class="meta-item">
            <div class="label">Source</div>
            <div class="value">{{ .Labels.source }}</div>
          </div>
        </div>

        {{ if .Annotations.error_sample }}
        <div class="label">Error Sample</div>
        <div class="value" style="font-family: monospace; font-size: 12px; background: #2c3e50; color: #ecf0f1; padding: 12px; border-radius: 4px;">{{ .Annotations.error_sample }}</div>
        {{ end }}

        {{ if .Annotations.runbook }}
        <div class="label">Runbook</div>
        <div class="value">{{ .Annotations.runbook }}</div>
        {{ end }}

        {{ if .Annotations.grafana_dashboard }}
        <a href="{{ .Annotations.grafana_dashboard }}" class="btn">📊 Open in Grafana</a>
        {{ end }}

      </div>
      {{ end }}
    </div>

    <!-- Footer -->
    <div class="footer">
      AIOps Alerting System &bull; 
      <a href="http://192.168.29.25:9093">Alertmanager</a> &bull; 
      <a href="http://192.168.29.25:9090">Prometheus</a> &bull; 
      <a href="http://192.168.29.25:3000">Grafana</a>
    </div>
  </div>
</body>
</html>
{{ end }}
