# ============================================================
# ALERTMANAGER CONFIGURATION
# Severity-tiered routing with deduplication
# ============================================================

global:
  resolve_timeout: 5m

  # ── SMTP settings for email notifications ──
  # UPDATE: Replace with your actual SMTP credentials
  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "aditya.tiwari@sigmainfo.net"
  smtp_auth_username: "aditya.tiwari@sigmainfo.net"
  smtp_auth_password: "dycppwcjukmgkcfj"
  smtp_require_tls: true

# ────────────────────────────────────────────────────────────
# TEMPLATES  —  rich email formatting
# ────────────────────────────────────────────────────────────
templates:
  - "/etc/alertmanager/templates/*.tmpl"

# ────────────────────────────────────────────────────────────
# ROUTE TREE  —  severity-based routing with deduplication
#
# Deduplication via repeat_interval:
#   P1 = 15 minutes (same alert won't re-fire within 15 min)
#   P2 = 1 hour
#   P3 = 24 hours
# ────────────────────────────────────────────────────────────
route:
  receiver: "default-email"
  group_by: ["alertname", "severity", "service"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 24h          # default fallback (P3-level)

  routes:
    # ── AUTO-REMEDIATION: dispatch to webhook ──
    - match_re:
        remediation: ".+"
      receiver: "auto-remediation-webhook"
      group_wait: 10s
      repeat_interval: 5m
      continue: true

    # ── P1: CRITICAL  —  immediate escalation ──
    - match:
        severity: p1
      receiver: "p1-critical"
      group_wait: 15s            # fire fast
      group_interval: 1m
      repeat_interval: 15m       # cooldown: 15 minutes
      continue: false

    # ── P2: HIGH  —  within 1 hour ──
    - match:
        severity: p2
      receiver: "p2-high"
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 1h        # cooldown: 1 hour
      continue: false

    # ── P3: LOW  —  daily digest ──
    - match:
        severity: p3
      receiver: "p3-daily"
      group_wait: 5m
      group_interval: 30m
      repeat_interval: 24h       # cooldown: 24 hours
      continue: false

# ────────────────────────────────────────────────────────────
# RECEIVERS
# ────────────────────────────────────────────────────────────
receivers:

  # ── Auto-remediation webhook ──
  - name: "auto-remediation-webhook"
    webhook_configs:
      - url: "http://127.0.0.1:5001/webhook"
        send_resolved: true

  # ── Default fallback ──
  - name: "default-email"
    email_configs:
      - to: "aditya.tiwari@sigmainfo.net"
        send_resolved: true
        html: '{{ template "email.alert" . }}'
        headers:
          Subject: '[AIOps] {{ .GroupLabels.severity | toUpper }} — {{ .GroupLabels.alertname }}'

  # ── P1: Email + PagerDuty ──
  - name: "p1-critical"
    email_configs:
      - to: "aditya.tiwari@sigmainfo.net"
        send_resolved: true
        html: '{{ template "email.alert" . }}'
        headers:
          Subject: '🚨 [P1-CRITICAL] {{ .GroupLabels.alertname }} — IMMEDIATE ACTION'

    # ── PagerDuty for P1 ──
    # UPDATE: Replace with your actual PagerDuty integration key
    # pagerduty_configs:
    #   - service_key: "<YOUR_PAGERDUTY_SERVICE_KEY>"
    #     severity: critical
    #     description: '{{ .GroupLabels.alertname }}: {{ .CommonAnnotations.summary }}'
    #     details:
    #       platform: '{{ .CommonAnnotations.platform }}'
    #       environment: '{{ .CommonAnnotations.environment }}'
    #       dashboard: '{{ .CommonAnnotations.grafana_dashboard }}'

    # ── Slack for P1 (optional) ──
    # UPDATE: Replace with your actual Slack webhook URL
    # slack_configs:
    #   - api_url: "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"
    #     channel: "#p1-critical-alerts"
    #     title: '🚨 P1 CRITICAL — {{ .GroupLabels.alertname }}'
    #     text: >-
    #       *Summary:* {{ .CommonAnnotations.summary }}
    #       *Platform:* {{ .CommonAnnotations.platform }}
    #       *Environment:* {{ .CommonAnnotations.environment }}
    #       *Error:* {{ .CommonAnnotations.error_sample }}
    #       *Dashboard:* {{ .CommonAnnotations.grafana_dashboard }}
    #     send_resolved: true

  # ── P2: Email only ──
  - name: "p2-high"
    email_configs:
      - to: "aditya.tiwari@sigmainfo.net"
        send_resolved: true
        html: '{{ template "email.alert" . }}'
        headers:
          Subject: '⚠️ [P2-HIGH] {{ .GroupLabels.alertname }} — respond within 1 hour'

  # ── P3: Email daily digest ──
  - name: "p3-daily"
    email_configs:
      - to: "aditya.tiwari@sigmainfo.net"
        send_resolved: true
        html: '{{ template "email.alert" . }}'
        headers:
          Subject: 'ℹ️ [P3-LOW] {{ .GroupLabels.alertname }} — daily digest'

# ────────────────────────────────────────────────────────────
# INHIBITION RULES
# Suppress lower-severity alerts when higher-severity fires
# for the same service
# ────────────────────────────────────────────────────────────
inhibit_rules:

  # P1 firing → suppress P2 for same service
  - source_match:
      severity: p1
    target_match:
      severity: p2
    equal: ["service"]

  # P1 firing → suppress P3 for same service
  - source_match:
      severity: p1
    target_match:
      severity: p3
    equal: ["service"]

  # P2 firing → suppress P3 for same service
  - source_match:
      severity: p2
    target_match:
      severity: p3
    equal: ["service"]
