# ============================================================
# PROMETHEUS ALERTING RULES  —  metric-based alerts
# ============================================================
groups:

  # ────────────────────────────────────────────────────────────
  # P1 — CRITICAL / IMMEDIATE  (fires within 2 minutes)
  # ────────────────────────────────────────────────────────────
  - name: p1-critical-metric-alerts
    interval: 15s
    rules:

      # 5xx error rate exceeds 5% for 2 consecutive minutes
      - alert: P1_5xxErrorRateCritical
        expr: |
          (
            sum(rate(nginx_http_requests_total{status=~"5.."}[2m]))
            /
            sum(rate(nginx_http_requests_total[2m]))
          ) > 0.05
        for: 2m
        labels:
          severity: p1
          tier: critical
          service: nginx
          source: prometheus
        annotations:
          summary: "🚨 5xx error rate exceeds 5%"
          description: "The HTTP 5xx error rate has been above 5% for 2 consecutive minutes. Current value: {{ $value | humanizePercentage }}."
          platform: "dev.regenics.com"
          environment: "production"
          error_sample: "5xx error rate = {{ $value | humanizePercentage }} — server errors impacting users"
          grafana_dashboard: "http://192.168.29.25:3000/explore?orgId=1&left=%7B%22datasource%22:%22prometheus%22,%22queries%22:%5B%7B%22expr%22:%22sum(rate(nginx_http_requests_total%7Bstatus%3D~%5C%225..%5C%22%7D%5B2m%5D))%20/%20sum(rate(nginx_http_requests_total%5B2m%5D))%22%7D%5D%7D"
          runbook: "Check nginx error logs. Verify upstream PHP-FPM is healthy. Check deployment status."

      # Total 5xx count spike (absolute threshold)
      - alert: P1_5xxCountSpike
        expr: |
          sum(increase(nginx_http_requests_total{status=~"5.."}[2m])) > 50
        for: 2m
        labels:
          severity: p1
          tier: critical
          service: nginx
          source: prometheus
        annotations:
          summary: "🚨 5xx error count spike (>50 in 2min)"
          description: "More than 50 HTTP 5xx errors in the last 2 minutes. Absolute count: {{ $value }}."
          platform: "dev.regenics.com"
          environment: "production"
          error_sample: "5xx count = {{ $value }} in 2 minutes"
          grafana_dashboard: "http://192.168.29.25:3000/explore?orgId=1&left=%7B%22datasource%22:%22prometheus%22,%22queries%22:%5B%7B%22expr%22:%22sum(increase(nginx_http_requests_total%7Bstatus%3D~%5C%225..%5C%22%7D%5B2m%5D))%22%7D%5D%7D"

  # ────────────────────────────────────────────────────────────
  # P2 — HIGH / WITHIN 1 HOUR
  # ────────────────────────────────────────────────────────────
  - name: p2-high-metric-alerts
    interval: 30s
    rules:

      # High request latency (if histogram metrics available)
      - alert: P2_HighRequestLatency
        expr: |
          histogram_quantile(0.95, sum(rate(nginx_http_request_duration_seconds_bucket[5m])) by (le)) > 2
        for: 5m
        labels:
          severity: p2
          tier: high
          service: nginx
          source: prometheus
        annotations:
          summary: "⚠️ P95 request latency exceeds 2 seconds"
          description: "The 95th percentile of request latency has been above 2 seconds for 5 minutes. Current P95: {{ $value }}s."
          platform: "dev.regenics.com"
          environment: "production"
          grafana_dashboard: "http://192.168.29.25:3000/explore?orgId=1&left=%7B%22datasource%22:%22prometheus%22,%22queries%22:%5B%7B%22expr%22:%22histogram_quantile(0.95%2C%20sum(rate(nginx_http_request_duration_seconds_bucket%5B5m%5D))%20by%20(le))%22%7D%5D%7D"

      # Upstream connection errors
      - alert: P2_UpstreamConnectionErrors
        expr: |
          sum(rate(nginx_http_requests_total{status=~"502|503|504"}[5m])) > 0.5
        for: 5m
        labels:
          severity: p2
          tier: high
          service: nginx
          source: prometheus
        annotations:
          summary: "⚠️ Upstream connection errors (502/503/504)"
          description: "Elevated 502/503/504 errors indicate backend PHP-FPM or upstream issues."
          platform: "dev.regenics.com"
          environment: "production"
          grafana_dashboard: "http://192.168.29.25:3000/explore?orgId=1&left=%7B%22datasource%22:%22prometheus%22,%22queries%22:%5B%7B%22expr%22:%22sum(rate(nginx_http_requests_total%7Bstatus%3D~%5C%22502%7C503%7C504%5C%22%7D%5B5m%5D))%22%7D%5D%7D"

  # ────────────────────────────────────────────────────────────
  # P3 — LOW / DAILY DIGEST
  # ────────────────────────────────────────────────────────────
  - name: p3-low-metric-alerts
    interval: 1m
    rules:

      # Disk space running low
      - alert: P3_DiskSpaceLow
        expr: |
          (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) < 0.20
        for: 30m
        labels:
          severity: p3
          tier: low
          service: node
          source: prometheus
        annotations:
          summary: "ℹ️ Disk space below 20%"
          description: "Root filesystem has less than 20% free space. Current free: {{ $value | humanizePercentage }}."
          platform: "infrastructure"
          environment: "production"

      # High memory usage
      - alert: P3_HighMemoryUsage
        expr: |
          (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) > 0.85
        for: 30m
        labels:
          severity: p3
          tier: low
          service: node
          source: prometheus
        annotations:
          summary: "ℹ️ Memory usage above 85%"
          description: "Memory usage has been above 85% for 30 minutes. Current usage: {{ $value | humanizePercentage }}."
          platform: "infrastructure"
          environment: "production"

      # High CPU usage
      - alert: P3_HighCPUUsage
        expr: |
          100 - (avg(rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 85
        for: 30m
        labels:
          severity: p3
          tier: low
          service: node
          source: prometheus
        annotations:
          summary: "ℹ️ CPU usage above 85%"
          description: "Average CPU usage has been above 85% for 30 minutes."
          platform: "infrastructure"
          environment: "production"

  # ────────────────────────────────────────────────────────────
  # AUTO-REMEDIATION — METRIC ALERTS
  # ────────────────────────────────────────────────────────────
  - name: auto-remediation-alerts
    rules:
      - alert: PHPFPMWorkerPoolExhaustion
        expr: phpfpm_active_processes{pool="www"} / phpfpm_max_active_processes{pool="www"} > 0.90
        for: 1m
        labels:
          severity: p1
          remediation: fpm-reload
        annotations:
          summary: "🚨 PHP-FPM pool exhaustion (>90%)"
          description: "Active processes are above 90% of max children for 1 minute."

      - alert: RedisMemoryHigh
        expr: redis_memory_used_bytes / redis_memory_max_bytes > 0.90
        for: 2m
        labels:
          severity: p1
          remediation: redis-flush-cache
        annotations:
          summary: "🚨 Redis memory usage exceeds 90%"
          description: "Redis instance is using more than 90% of its max memory."
