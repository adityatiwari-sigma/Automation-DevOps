# ============================================================
# PROMETHEUS CONFIGURATION  (generated from this template by generate_configs.py)
# Edit prometheus/prometheus.yml.template — NOT the generated prometheus.yml
# ============================================================

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s
  external_labels:
    cluster: "aiops-local"
    environment: "__PLATFORM_ENV__"

# ────────────────────────────────────────────────────────────
# ALERTING — forward firing rules to Alertmanager
# ────────────────────────────────────────────────────────────
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:__ALERTMANAGER_PORT__"

# ────────────────────────────────────────────────────────────
# RECORDING & ALERTING RULE FILES
# ────────────────────────────────────────────────────────────
rule_files:
  - "/etc/prometheus/rules/*.yaml"
  - "/etc/prometheus/rules/*.yml"

# ────────────────────────────────────────────────────────────
# SCRAPE CONFIGS
# ────────────────────────────────────────────────────────────
scrape_configs:

  # ── Prometheus self-monitoring ──
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:__PROMETHEUS_PORT__"]
        labels:
          service: prometheus

  # ── Local Node Exporter (host metrics) ──
  - job_name: "node-exporter-local"
    static_configs:
      - targets: ["node-exporter:__NODE_EXPORTER_PORT__"]
        labels:
          service: node-exporter
          instance_name: "aiops-host"

  # ── Local cAdvisor (container metrics) ──
  - job_name: "cadvisor"
    static_configs:
      - targets: ["cadvisor:8080"]
        labels:
          service: cadvisor
          instance_name: "aiops-host"

  # ── Loki internal metrics ──
  - job_name: "loki"
    static_configs:
      - targets: ["loki:__LOKI_PORT__"]
        labels:
          service: loki

  # ── Alertmanager internal metrics ──
  - job_name: "alertmanager"
    static_configs:
      - targets: ["alertmanager:__ALERTMANAGER_PORT__"]
        labels:
          service: alertmanager

  # ── Remote Nginx Exporter ──
  - job_name: "nginx-exporter-remote"
    static_configs:
      - targets: ["__REMOTE_IP__:__NGINX_EXPORTER_PORT__"]
        labels:
          service: nginx
          platform: "__PLATFORM_NAME__"
          environment: "__PLATFORM_ENV__"
          instance_name: "__INSTANCE_NAME__"

  # ── Remote Node Exporter ──
  - job_name: "node-exporter-remote"
    static_configs:
      - targets: ["__REMOTE_IP__:__NODE_EXPORTER_PORT__"]
        labels:
          service: node-exporter
          platform: "__PLATFORM_NAME__"
          environment: "__PLATFORM_ENV__"
          instance_name: "__INSTANCE_NAME__"

  # ── Remote Promtail (scrapes nginx_request_duration_ms histogram) ──
  # honor_labels: false here — let Prometheus own the job/instance labels
  - job_name: "promtail-remote"
    honor_labels: false
    static_configs:
      - targets: ["__REMOTE_IP__:__PROMTAIL_PORT__"]
        labels:
          service: promtail
          platform: "__PLATFORM_NAME__"
          environment: "__PLATFORM_ENV__"
          instance_name: "__INSTANCE_NAME__"

  # ── Pushgateway (Playwright / CWV probe metrics) ──
  - job_name: "pushgateway"
    honor_labels: true
    static_configs:
      - targets: ["__LOCAL_IP__:__PUSHGATEWAY_PORT__"]
        labels:
          service: pushgateway
