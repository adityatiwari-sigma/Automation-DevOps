{
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Global Summary (All Selected URLs)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 } ] },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [ 
        { 
          "expr": "avg(avg_over_time((probe_http_status{page=~\"$url\"} == bool 200)[$__range:15s])) * 100", 
          "refId": "A" 
        } 
      ],
      "title": "Avg Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "sum(probe_js_errors{page=~\"$url\"})", "refId": "A" } ],
      "title": "Total active JS Errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "count(probe_http_status{page=~\"$url\"} != 200) OR on() vector(0)", "refId": "A" } ],
      "title": "Unhealthy URLs",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "panels": [],
      "repeat": "url",
      "title": "Target Details: $url",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 6, "w": 10, "x": 0, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "probe_ttfb_ms{page=\"$url\"}", "legendFormat": "TTFB", "refId": "A" },
        { "expr": "probe_lcp_ms{page=\"$url\"}", "legendFormat": "LCP", "refId": "B" }
      ],
      "title": "Performance Metrics",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { 
        "defaults": { 
          "color": { "mode": "thresholds" }, 
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "min": 0
        } 
      },
      "gridPos": { "h": 6, "w": 4, "x": 10, "y": 6 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "probe_js_errors{page=\"$url\"}", "refId": "A" } ],
      "title": "JS Errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [
            { "options": { "200": { "color": "green", "text": "OK" } }, "type": "value" },
            { "options": { "from": 201, "result": { "color": "red" }, "to": 599 }, "type": "range" }
          ]
        }
      },
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 6 },
      "id": 8,
      "options": { "mergeValues": true, "showValue": "auto" },
      "targets": [ { "expr": "probe_http_status{page=\"$url\"}", "legendFormat": "Status", "refId": "A" } ],
      "title": "Availability History",
      "type": "state-timeline"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [ "playwright", "synthetic" ],
  "templating": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(probe_http_status, page)",
        "hide": 0,
        "includeAll": true,
        "label": "Target URL",
        "multi": true,
        "name": "url",
        "options": [],
        "query": { "query": "label_values(probe_http_status, page)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Playwright Synthetic Probing",
  "uid": "playwright-probing",
  "version": 5
}
