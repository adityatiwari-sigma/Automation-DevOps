    {
      "id": 104,
      "title": "5xx Rate",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              },
              {
                "color": "dark-red",
                "value": 0.05
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total{status=~\"5..\"}[2m])) / sum(rate(nginx_http_requests_total[2m]))",
          "instant": true
        }
      ]
    },
    {
      "id": 1,
      "title": "Top Error Groups (last 24 h)",
      "description": "Top 20 nginx error patterns extracted via regexp named capture group (?P<err>). Click a row to drill into raw logs in Panel 3.",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ],
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Count"
          ],
          "countRows": false,
          "enablePagination": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 50
                    },
                    {
                      "color": "red",
                      "value": 200
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error Pattern"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 600
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View logs for this error",
                    "url": "/d/${__dashboard.uid}/error-groups?var-platform=${__data.fields.Platform}&var-err=${__data.fields[\"Error Pattern\"]}&panelId=3&orgId=1",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Platform"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (err, platform, environment) (count_over_time({level=~\"error|critical|fatal|emergency|err\", platform=~\"$platform\", environment=~\"$environment\"} | regexp \"^.*?(?:\\\\[error\\\\]|ERROR|[\\\\w.]+ERROR|Error|CRITICAL)\\\\s*(?:\\\\[[^\\\\]]+\\\\]\\\\s*)*[:]?\\\\s*(?:\\\\d+#\\\\d+:\\\\s+)?(?:\\\\*\\\\d+\\\\s+)?(?P<err>\\\\S.*?)(?:, (?:client|server|request|host|upstream):.*|$)\" [24h])))",
          "instant": true,
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "err": "Error Pattern",
              "platform": "Platform",
              "environment": "Environment",
              "Value": "Count",
              "Time": "Sampled At"
            },
            "indexByName": {
              "Error Pattern": 0,
              "Platform": 1,
              "Environment": 2,
              "Count": 3
            },
            "excludeByName": {
              "Sampled At": true
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Volume by Platform (7 days)",
      "description": "Count of matched nginx ERROR log lines per platform over 7 days. Uses $__interval so resolution adapts as you zoom.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum",
            "max",
            "mean"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (platform) (count_over_time({level=~\"error|critical|fatal|emergency|err\", platform=~\"$platform\", environment=~\"$environment\"} | regexp \"^.*?(?:\\\\[error\\\\]|ERROR|[\\\\w.]+ERROR|Error|CRITICAL)\\\\s*(?:\\\\[[^\\\\]]+\\\\]\\\\s*)*[:]?\\\\s*(?:\\\\d+#\\\\d+:\\\\s+)?(?:\\\\*\\\\d+\\\\s+)?(?P<err>\\\\S.*?)(?:, (?:client|server|request|host|upstream):.*|$)\" [$__interval]))",
          "legendFormat": "{{platform}}",
          "queryType": "range"
        }
      ],
      "timeFrom": "now-7d"
    },
    {
      "id": 3,
      "title": "Log Drill-Down",
      "description": "Raw nginx error log lines filtered by the error pattern selected in the table above. Populated via data link — set ?panelId=3 in the URL to jump here.",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{level=~\"error|critical|fatal|emergency|err\", platform=~\"${platform:pipe}\", environment=~\"$environment\"} | regexp \"^.*?(?:\\\\[error\\\\]|ERROR|[\\\\w.]+ERROR|Error|CRITICAL)\\\\s*(?:\\\\[[^\\\\]]+\\\\]\\\\s*)*[:]?\\\\s*(?:\\\\d+#\\\\d+:\\\\s+)?(?:\\\\*\\\\d+\\\\s+)?(?P<err>\\\\S.*?)(?:, (?:client|server|request|host|upstream):.*|$)\" |= \"$err\"",
          "legendFormat": "",
          "queryType": "range",
          "maxLines": 500
        }
      ]
    },
    {
      "id": 15,
      "title": "Performance Analysis",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Latency Percentiles (P50, P75, P95, P99)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(promtail_custom_nginx_request_duration_ms_bucket{platform=~\"$platform\", environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum by (le) (rate(promtail_custom_nginx_request_duration_ms_bucket{platform=~\"$platform\", environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "P75",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(promtail_custom_nginx_request_duration_ms_bucket{platform=~\"$platform\", environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{uri}} - P95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(promtail_custom_nginx_request_duration_ms_bucket{platform=~\"$platform\", environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "lineWidth": 2,
            "spanNulls": true
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Top 10 Slowest Pages (last 1h)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(10, avg by (uri) (avg_over_time({type=\"perf\", platform=~\"$platform\", environment=~\"$environment\"} | json | unwrap response_time_ms [1h]))) * 1000",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "uri": 0,
              "Value #A": 1
            },
            "renameByName": {
              "Value #A": "Response Time (ms)",
              "uri": "URL/Page"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Response Time (ms)",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 12,
      "title": "URL Response Time Heatmap",
      "type": "heatmap",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(promtail_custom_nginx_request_duration_ms_bucket{platform=~\"$platform\", environment=~\"$environment\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "yAxis": {
          "unit": "ms"
        }
      }
    }
  ],
