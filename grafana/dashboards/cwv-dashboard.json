    {
      "id": 7,
      "title": "Page Load Health Rate (% Good)",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(sum(count_over_time({job=\"cwv_rum\", platform=~\"$platform\", rating=\"good\"} | json | label_format url=\"{{.url}}\" | url=~\"$uri\" [$__range])) or vector(0)) / (sum(count_over_time({job=\"cwv_rum\", platform=~\"$platform\"} | json | label_format url=\"{{.url}}\" | url=~\"$uri\" [$__range])) or vector(1))",
          "legendFormat": "Pass Rate"
        }
      ]
    },
