  "panels": [
    {
      "id": 1,
      "title": "Overall Performance Status (P75)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "LCP P75 (Largest Contentful Paint)",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 5000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2500 },
              { "color": "red", "value": 4000 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "topk(10, quantile_over_time(0.75, {job=\"cwv_rum\", platform=~\"$platform\", metric_name=\"LCP\"} | json | label_format url=\"{{.url}}\" | url=~\"$uri\" | unwrap value [$__range]) by (url))",
          "legendFormat": "{{url}}"
        }
      ]
    },
    {
