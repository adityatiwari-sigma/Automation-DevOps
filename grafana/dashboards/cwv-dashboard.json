        { "refId": "FCP", "expr": "quantile_over_time(0.75, {job=\"cwv_rum\", platform=~\"$platform\", metric_name=\"FCP\"} | json | label_format url=\"{{.url}}\" | url=~\"$uri\" | unwrap value [$__range]) by (url)", "instant": true },
