      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "LCP (P75)", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": true, "displayMode": "color-background" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
