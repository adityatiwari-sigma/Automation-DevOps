            "value": "ccs|corporatecare"
          }
        ],
        "query": "Regenics : regenics|/error.log$, CCS : ccs|corporatecare",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "hide": 2,
        "label": "Error pattern filter",
        "name": "err",
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox"
      },
      {
        "current": {},
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({filename=~\"(?i).*($project).*\"}, platform)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Platform",
        "multi": true,
        "name": "platform",
        "options": [],
        "query": {
          "label": "platform",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{filename=~\"(?i).*($project).*\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Project Dashboard",
  "uid": "project-dashboard-v1"
}
