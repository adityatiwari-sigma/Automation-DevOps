{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Dynamic project dashboard filtering by selected project (Regenics/CCS). Includes consolidated log views and high-level error aggregation.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 100,
      "title": "Error Logs per Project (30d Trend)",
      "type": "timeseries",
      "timeFrom": "30d",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (platform) (count_over_time({level=~\"(?i).*(error|critical|fatal|emergency|warn|err).*\", filename=~\"(?i).*($project).*\", platform=~\"$platform\"} [$__interval]))",
          "refId": "A",
          "legendFormat": "{{platform}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Top Error Groups (last 2 d)",
      "type": "table",
      "timeFrom": "2d",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ],
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Count"
          ],
          "countRows": false,
          "enablePagination": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error Pattern"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 850
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View full logs for this error pattern",
                    "url": "/d/${__dashboard.uid}?var-project=${project}&var-platform=${__data.fields.Platform}&var-err=${__data.fields[\"Error Pattern\"]}&viewPanel=11&from=now-2d&to=now",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (err, platform) (count_over_time({level=~\"(?i).*(error|critical|fatal|emergency|warn|err).*\", filename=~\"(?i).*($project).*\", platform=~\"$platform\"} | regexp \"^.*?(?:\\\\[error\\\\]|ERROR|[\\\\w.]+ERROR|Error|CRITICAL|\\\\[Warning\\\\]|Warning|WARN|Warn|\\\\[Warn\\\\])\\\\s*(?:\\\\[[^\\\\]]+\\\\]\\\\s*)*[:]?\\\\s*(?:\\\\d+#\\\\d+:\\\\s+)?(?:\\\\*\\\\d+\\\\s+)?(?P<err>\\\\S.*?)(?:, (?:client|server|request|host|upstream):.*|$)\" [2d])))",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "organize",
          "options": {
            "renameByName": { "err": "Error Pattern", "platform": "Platform", "Value": "Count" },
            "indexByName": { "Error Pattern": 0, "Platform": 1, "Count": 2 },
            "excludeByName": { "Time": true }
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Log Drill-Down Details",
      "type": "logs",
      "timeFrom": "2d",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{level=~\"(?i).*(error|critical|fatal|emergency|warn|err).*\", filename=~\"(?i).*($project).*\", platform=~\"${platform:pipe}\"} |= `${err}`",
          "queryType": "range",
          "maxLines": 500
        }
      ]
    },
    {
      "id": 1,
      "title": "Nginx Error Logs",
      "type": "logs",
      "timeFrom": "30d",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{log_type=\"nginx-error\", filename=~\"(?i).*($project).*\"}",
          "refId": "A",
          "maxLines": 50
        }
      ]
    },
    {
      "id": 3,
      "title": "MySQL Error Logs",
      "type": "logs",
      "timeFrom": "30d",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 37 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{platform=\"mysql\", filename=~\"(?i).*($project).*\"}",
          "refId": "A",
          "maxLines": 50
        }
      ]
    },
    {
      "id": 8,
      "title": "MySQL Slow Queries",
      "type": "logs",
      "timeFrom": "30d",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 46 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{platform=\"mysql\", filename=~\"(?i).*slow.*\"} |~ \"(?i)($project)\"",
          "refId": "A",
          "maxLines": 50
        }
      ]
    },
    {
      "id": 5,
      "title": "Application Logs",
      "type": "logs",
      "timeFrom": "30d",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 55 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{platform=~\"wordpress|laravel\", filename=~\"(?i).*($project).*\"}",
          "refId": "A",
          "maxLines": 50
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Regenics",
          "value": "regenics|/error.log$"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Project",
        "multi": false,
        "name": "project",
        "options": [
          {
            "selected": true,
            "text": "Regenics",
            "value": "regenics|/error.log$"
          },
          {
            "selected": false,
