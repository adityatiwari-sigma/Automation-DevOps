      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Largest Contentful Paint over time. The red threshold at 4000ms triggers correlation analysis.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "LCP (ms)",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 4000 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 1 },
      "id": 101,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_lcp_ms{page=~\"$url\"}",
          "legendFormat": "LCP — {{ page }}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_ttfb_ms{page=~\"$url\"}",
          "legendFormat": "TTFB — {{ page }}",
          "refId": "B"
        }
      ],
      "title": "LCP & TTFB Over Time",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current maximum LCP across all monitored pages.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2500 },
              { "color": "red", "value": 4000 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "id": 102,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(probe_lcp_ms{page=~\"$url\"})",
          "legendFormat": "Max LCP",
          "refId": "A"
        }
      ],
      "title": "Current LCP",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Shows the active auto-detected root cause label from correlation alerts. No data = no issues detected.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null }
            ]
          },
          "noValue": "✅ Healthy"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 103,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(ALERTS{alertname=~\"LcpDegraded.*|LcpCorrelation.*\", alertstate=\"firing\"}) by (root_cause)",
          "legendFormat": "{{ root_cause }}",
          "refId": "A"
        }
      ],
      "title": "🔍 Active Root Cause",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "State timeline showing when each root cause was detected.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [
            { "options": { "0": { "color": "green", "text": "OK" } }, "type": "value" },
            { "options": { "1": { "color": "red", "text": "FIRING" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 10, "x": 14, "y": 5 },
      "id": 104,
      "options": { "mergeValues": true, "showValue": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ALERTS{alertname=~\"LcpDegraded.*|LcpCorrelation.*\", alertstate=\"firing\"}",
          "legendFormat": "{{ alertname }}",
          "refId": "A"
        }
      ],
      "title": "Correlation Alert Timeline",
      "type": "state-timeline"
