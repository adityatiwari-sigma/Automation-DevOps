server:
  http_listen_port: __PROMTAIL_PORT__

positions:
  filename: /var/log/promtail/positions.yaml

clients:
  - url: http://__LOCAL_IP__:__LOKI_PORT__/loki/api/v1/push

scrape_configs:
# ── NGINX ACCESS (JSON structured log) ──
- job_name: nginx-access
  static_configs:
    - targets: [localhost]
      labels:
        platform: nginx
        log_type: nginx-access
        type: perf
        environment: prod
        __path__: /var/log/nginx/*access.log
  pipeline_stages:
    - json:
        expressions:
          status:
          uri:
          raw_duration: response_time_ms
          raw_upstream: upstream_response_time
    - template:
        source: response_time_ms
        template: '{{ if .raw_duration }}{{ mulf (float64 .raw_duration) 1000.0 }}{{ end }}'
    - template:
        source: upstream_time_ms
        template: '{{ if and .raw_upstream (ne .raw_upstream "") (ne .raw_upstream "-") }}{{ mulf (float64 .raw_upstream) 1000.0 }}{{ end }}'
    - template:
        source: uri
        template: '{{ regexReplaceAll "\\?.*" .uri "" }}'
    - labels:
        status:
        uri:
    - metrics:
        nginx_request_duration_ms:
          type: Histogram
          description: "nginx request duration in milliseconds"
          source: response_time_ms
          config:
            buckets: [5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000]
            labels:
              status:
              uri:
              platform:
              environment:
        nginx_upstream_duration_ms:
          type: Histogram
          description: "nginx upstream response time in milliseconds"
          source: upstream_time_ms
          config:
            buckets: [5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000]
            labels:
              status:
              uri:
              platform:
              environment:

# ── NGINX ERROR (text) ──
- job_name: nginx-error
  static_configs:
    - targets: [localhost]
      labels:
        platform: nginx
        log_type: nginx-error
        environment: prod
        __path__: /var/log/nginx/*error.log
  pipeline_stages:
    - regex:
        expression: '^(?P<time>\d{4}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})'
    - timestamp:
        source: time
        format: '2006/01/02 15:04:05'
        location: 'Asia/Kolkata'
        action_on_failure: skip
    - regex:
        expression: '(?i)(?P<level>error|warn|info|debug|fatal|emergency|critical)'
    - labels:
        level:

# ── PHP-FPM ERROR ──
- job_name: php-fpm
  static_configs:
    - targets: [localhost]
      labels:
        platform: php-fpm
        log_type: php-fpm-error
        environment: prod
        __path__: /var/log/php*-fpm.log
  pipeline_stages:
    - regex:
        expression: '^\[(?P<time>\d{2}-[A-Za-z]+-\d{4}\s+\d{2}:\d{2}:\d{2}(?:\s+[A-Z]+)?)\]'
    - timestamp:
        source: time
        format: '02-Jan-2006 15:04:05'
        fallback_formats:
          - '02-Jan-2006 15:04:05 MST'
        location: 'Asia/Kolkata'
        action_on_failure: skip
    - regex:
        expression: '(?i)(?P<level>error|warn|notice|debug|fatal)'
    - labels:
        level:

# ── MYSQL ERROR ──
- job_name: mysql
  static_configs:
    - targets: [localhost]
      labels:
        platform: mysql
        log_type: mysql-error
        environment: prod
        __path__: /var/log/mysql/*.log
  pipeline_stages:
    - regex:
        expression: '^(?P<time>\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}(?:\.\d+)?)'
    - timestamp:
        source: time
        format: '2006-01-02 15:04:05'
        fallback_formats:
          - '2006-01-02 15:04:05.999999'
        location: 'Asia/Kolkata'
        action_on_failure: skip
    - regex:
        expression: '(?i)(?P<level>error|warning|note|info)'
    - labels:
        level:

# ── PLATFORM APPS (Laravel / WordPress / Magento) ──
- job_name: platform-apps
  static_configs:
    - targets: [localhost]
      labels:
        platform: laravel
        log_type: laravel-app
        environment: prod
        __path__: /var/www/html/*/storage/logs/*.log
    - targets: [localhost]
      labels:
        platform: wordpress
        log_type: wordpress-debug
        environment: prod
        __path__: /var/www/*/wp-content/debug.log
    - targets: [localhost]
      labels:
        platform: magento
        log_type: magento-app
        environment: prod
        __path__: /var/www/*/var/log/*.log
  pipeline_stages:
    - regex:
        expression: '^\[(?P<time>\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\]'
    - timestamp:
        source: time
        format: '2006-01-02 15:04:05'
        location: 'Asia/Kolkata'
        action_on_failure: skip
    - regex:
        expression: '(?i)(?P<level>error|warning|critical|fatal|notice|info|debug)'
    - labels:
        level:

# ── CORE WEB VITALS (RUM from Playwright) ──
- job_name: cwv-rum
  static_configs:
    - targets: [localhost]
      labels:
        job: cwv_rum
        platform: "__PLATFORM_NAME__"
        environment: "__PLATFORM_ENV__"
        __path__: /var/log/cwv/vitals.log
  pipeline_stages:
    - json:
        expressions:
          metric_name: metric
          metric_value: value
          rating: rating
          page_type: page_type
          url: url
          device: platform
    - labels:
        metric_name:
        rating:
        page_type:
        device:
